# Copy to .env.production and fill in. NEVER commit .env.production.
#
# Generate SECRET_KEY with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend REFUSES TO START with ENVIRONMENT=production and the default secret
# or the default database URL (see backend/app/core/config.py), so a forgotten value
# fails loudly at boot instead of running insecurely.

POSTGRES_USER=floodshield
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=floodshield_zambia

SECRET_KEY=CHANGE_ME_run_the_command_above

# Same-origin behind nginx, so CORS is rarely exercised. Set to your public origin anyway.
CORS_ORIGINS=https://your-domain.example

WEB_PORT=80
