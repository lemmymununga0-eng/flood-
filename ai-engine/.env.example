# FloodShield-Zambia AI Engine — Environment Variables
# =====================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.

# NASA POWER API (not required — API is free and open)
NASA_POWER_API_KEY=

# OpenWeatherMap API key (for real-time weather data)
OWM_API_KEY=your_openweathermap_api_key_here

# Future backend integration (leave blank for AI module only)
DATABASE_URL=postgresql://user:password@localhost:5432/floodshield
FASTAPI_SECRET_KEY=change_me_in_production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
