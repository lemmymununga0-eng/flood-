# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://floodshield:changeme@localhost:5432/floodshield_zambia

# --- Backend ---
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=changeme-generate-a-random-secret
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Weather / meteorological data sources ---
# NASA POWER has no key requirement for the standard API as of research time;
# verify current terms before relying on this in production (see docs/DATA-SOURCES.md).
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Near-real-time provider (OpenWeather or equivalent) — verify current plan/limits
# before implementation; see docs/DATA-SOURCES.md "TO VALIDATE".
OPENWEATHER_API_KEY=

# --- Alerts (optional, isolated behind an Alert Service — see ARCHITECTURE.md) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Model registry ---
MODEL_ARTIFACT_DIR=./ai-engine/models
ACTIVE_MODEL_VERSION=

# --- SMS alerts (demo) -------------------------------------------------------
# simulated (default): nothing is sent; the UI shows what WOULD be sent. Safe for demos.
# africastalking | twilio: send real SMS. Costs money; use your own verified numbers.
SMS_PROVIDER=simulated
SMS_MAX_RECIPIENTS=20
# Optional safety net: only these numbers may receive SMS, e.g. +260971234567,+260961234567
SMS_ALLOWED_NUMBERS=
# Africa's Talking (use username "sandbox" for free testing)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
