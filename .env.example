# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://floodshield:changeme@localhost:5432/floodshield_zambia

# --- Backend ---
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=changeme-generate-a-random-secret
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Weather / meteorological data sources ---
# NASA POWER has no key requirement for the standard API as of research time;
# verify current terms before relying on this in production (see docs/DATA-SOURCES.md).
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Near-real-time provider (OpenWeather or equivalent) — verify current plan/limits
# before implementation; see docs/DATA-SOURCES.md "TO VALIDATE".
OPENWEATHER_API_KEY=

# --- Model registry ---
MODEL_ARTIFACT_DIR=./ai-engine/models
ACTIVE_MODEL_VERSION=

# --- SMS alerts (manual, administrator-triggered only) ----------------------
# Nothing is ever texted automatically. All values below are placeholders; put real
# credentials only in your untracked .env, never here.
#
# simulated (default): nothing is sent; attempts are recorded as "simulated".
# africastalking:      submit to Africa's Talking (costs money outside the sandbox).
SMS_PROVIDER=simulated
# sandbox | production. Sandbox needs AFRICASTALKING_USERNAME=sandbox and a sandbox-app
# API key; production needs your live app username and key.
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional. Zambian operators generally require a registered sender ID (ZICTA/operator
# approval); leave blank to use the provider default until yours is approved.
AFRICASTALKING_SENDER_ID=
# Group broadcasts to a REAL provider stay locked until this is true AND a real test SMS
# to your own phone has been accepted by the provider.
SMS_BROADCAST_ENABLED=false
SMS_MAX_RECIPIENTS=20
# Optional safety net: only these numbers may receive SMS, e.g. +260971234567,+260961234567
SMS_ALLOWED_NUMBERS=
# Text prepended to every message.
SMS_MESSAGE_PREFIX=FloodShield DEMO
# Identical message to identical recipients is refused within this many minutes.
SMS_DUPLICATE_WINDOW_MINUTES=10
# Shared secret for Africa's Talking callbacks. Leave blank to disable them. When set,
# configure in the AT dashboard:
#   delivery reports: https://<your-backend>/api/v1/sms/delivery-report?token=<secret>
#   incoming SMS:     https://<your-backend>/api/v1/sms/inbound?token=<secret>
# (the incoming-SMS URL needs an AT shortcode/number; "Reply STOP" is only added to
# messages when this secret is set). Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SMS_WEBHOOK_SECRET=
